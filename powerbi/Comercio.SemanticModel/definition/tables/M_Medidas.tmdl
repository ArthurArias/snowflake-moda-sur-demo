	measure 'Spark svg ventas' =
			VAR mx = MAXX ( ALL ( D_MesSpark[MesNum] ), [Spark ventas] )
			VAR barras = CONCATENATEX ( ALL ( D_MesSpark[MesNum] ),
			    VAR v = [Spark ventas]
			    VAR bh = FORMAT ( DIVIDE ( v, mx ) * 44, "0.0", "en-US" )
			    VAR bt = DIVIDE ( v, mx ) * 44
			    VAR x = FORMAT ( ( D_MesSpark[MesNum] - 1 ) * 8 + 1.5, "0.0", "en-US" )
			    VAR y = FORMAT ( 44 - bt, "0.0", "en-US" )
			    VAR col = IF ( IF ( COUNTROWS ( VALUES ( D_Mes[MesNum] ) ) < 12, D_MesSpark[MesNum] IN VALUES ( D_Mes[MesNum] ), D_MesSpark[MesNum] = 12 ), "%23FF9F43", "%235E5E6A" )
			    RETURN IF ( ISBLANK ( v ), "", "<rect x='" & x & "' y='" & y & "' width='5' height='" & bh & "' rx='2' fill='" & col & "'/>" ),
			    "", D_MesSpark[MesNum] )
			RETURN "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 96 44'>" & barras & "</svg>"
		displayFolder: Minigráficos
		lineageTag: 3ca31777-5839-7b4c-0d53-65991d76dfba
		dataCategory: ImageUrl


	measure Fichas = [Visitas web] * 0.578
		formatString: #,0
		displayFolder: Online
		lineageTag: e2e9f699-8869-32a9-3390-d5541eefbce3

	measure Carritos = [Fichas] * 0.173
		formatString: #,0
		displayFolder: Online
		lineageTag: 5980c1b6-37ea-70f7-c777-91b65e99377e

	measure 'Compras online' = CALCULATE ( SUM ( F_Ventas[Tickets] ), KEEPFILTERS ( D_Linea[Linea] = "Online" ) )
		formatString: #,0
		displayFolder: Online
		lineageTag: 2480f184-70de-7699-1004-fa20005e6775

	measure 'Ventas online' = CALCULATE ( [Ventas], KEEPFILTERS ( D_Linea[Linea] = "Online" ) )
		formatString: #,0
		displayFolder: Online
		lineageTag: f0fd2e59-6cdd-0205-2f2d-0b1ba7c3ee28

	measure 'Ventas online mapa' = CALCULATE ( [Ventas], D_Linea[Linea] = "Online" )
		formatString: #,0
		displayFolder: Online
		lineageTag: 48884f4d-9d11-b172-7912-acb7dde70b33

	measure 'Cuota online' = DIVIDE ( CALCULATE ( [Ventas], D_Linea[Linea] = "Online" ), CALCULATE ( [Ventas], REMOVEFILTERS ( D_Linea ) ) )
		formatString: 0.0%
		displayFolder: Online
		lineageTag: 54289be9-f977-d1f8-28da-a3453ee98abe

	measure 'Valor embudo' = SWITCH ( SELECTEDVALUE ( D_Embudo[Orden] ), 1, [Visitas web], 2, [Fichas], 3, [Carritos], 4, [Compras online] )
		formatString: #,0
		displayFolder: Online
		lineageTag: a4036548-2cd7-b480-0682-5b82c371144b

	measure 'Valor puente' =
			VAR p = SELECTEDVALUE ( D_Puente[Orden] )
			VAR l = SELECTEDVALUE ( D_Puente[Linea] )
			RETURN IF ( p = 1, [Ventas Ant], CALCULATE ( [Crecimiento], KEEPFILTERS ( D_Linea[Linea] = l ) ) )
		formatString: #,0
		displayFolder: Online
		lineageTag: 3c915d50-6fe8-8d68-a648-28beec182776

	measure 'Mes de la foto de stock' = MAX ( D_Mes[MesNum] )
		formatString: 0
		displayFolder: Stock
		lineageTag: 6d5c70d5-77fe-d960-f460-814ac897063a

	measure Posiciones =
			VAR m = [Mes de la foto de stock]
			RETURN CALCULATE ( SUM ( F_Stock[Posiciones] ), D_Mes[MesNum] = m )
		formatString: #,0.0
		displayFolder: Stock
		lineageTag: 68a50c3b-f9a4-e295-956a-a9d77e4896d2

	measure 'Posiciones bajas' =
			VAR m = [Mes de la foto de stock]
			RETURN CALCULATE ( SUM ( F_Stock[PosicionesBajas] ), D_Mes[MesNum] = m )
		formatString: #,0.0
		displayFolder: Stock
		lineageTag: 4a6095dc-89a0-966c-7dc6-fa8255abf90a

	measure 'Posiciones agotadas' =
			VAR m = [Mes de la foto de stock]
			RETURN CALCULATE ( SUM ( F_Stock[PosicionesAgotadas] ), D_Mes[MesNum] = m )
		formatString: #,0.0
		displayFolder: Stock
		lineageTag: 9cdec4f0-d89e-95b9-4ad4-8edbfae63026

	measure 'Posiciones en stock' = [Posiciones] - [Posiciones bajas] - [Posiciones agotadas]
		formatString: #,0.0
		displayFolder: Stock
		lineageTag: 59e7dbcb-ff7a-c33b-9b01-2bd099f64286

	measure 'Coste art-mes' = CALCULATE ( SUM ( F_Ventas[Coste] ), REMOVEFILTERS ( D_Linea ), REMOVEFILTERS ( D_Territorio ) )
		formatString: #,0
		displayFolder: Stock
		lineageTag: a5f08da5-232c-509d-5b3d-07815defbd4d

	measure 'Cobertura días' =
			VAR m = [Mes de la foto de stock]
			RETURN
			IF ( m < 1, BLANK (),
			    DIVIDE (
			        SUMX ( VALUES ( D_Articulo[ArticuloId] ),
			            CALCULATE ( MAX ( F_Cobertura[Dias] ), D_Mes[MesNum] = m ) * CALCULATE ( [Coste art-mes], D_Mes[MesNum] = m ) ),
			        SUMX ( VALUES ( D_Articulo[ArticuloId] ), CALCULATE ( [Coste art-mes], D_Mes[MesNum] = m ) ) ) )
		formatString: 0
		displayFolder: Stock
		lineageTag: 0b84edb2-53ed-1646-f716-18825082c267

	measure 'Cobertura días mes ant' =
			VAR m = [Mes de la foto de stock] - 1
			RETURN
			IF ( m < 1, BLANK (),
			    DIVIDE (
			        SUMX ( VALUES ( D_Articulo[ArticuloId] ),
			            CALCULATE ( MAX ( F_Cobertura[Dias] ), D_Mes[MesNum] = m ) * CALCULATE ( [Coste art-mes], D_Mes[MesNum] = m ) ),
			        SUMX ( VALUES ( D_Articulo[ArticuloId] ), CALCULATE ( [Coste art-mes], D_Mes[MesNum] = m ) ) ) )
		formatString: 0
		displayFolder: Stock
		lineageTag: 8c9ffac1-1c1e-a94b-677b-a5703da04d98

	measure 'Stock lento %' =
			VAR m = [Mes de la foto de stock]
			VAR t = ADDCOLUMNS ( VALUES ( D_Articulo[ArticuloId] ),
			    "@d", CALCULATE ( MAX ( F_Cobertura[Dias] ), D_Mes[MesNum] = m ),
			    "@c", CALCULATE ( [Coste art-mes], D_Mes[MesNum] = m ) )
			RETURN IF ( m < 1, BLANK (), DIVIDE ( SUMX ( FILTER ( t, [@d] >= 90 ), [@d] * [@c] ), SUMX ( t, [@d] * [@c] ) ) )
		formatString: 0.0%
		displayFolder: Stock
		lineageTag: 8c13e008-b17f-151d-6278-5070d71358ad

	measure 'Stock lento % mes ant' =
			VAR m = [Mes de la foto de stock] - 1
			VAR t = ADDCOLUMNS ( VALUES ( D_Articulo[ArticuloId] ),
			    "@d", CALCULATE ( MAX ( F_Cobertura[Dias] ), D_Mes[MesNum] = m ),
			    "@c", CALCULATE ( [Coste art-mes], D_Mes[MesNum] = m ) )
			RETURN IF ( m < 1, BLANK (), DIVIDE ( SUMX ( FILTER ( t, [@d] >= 90 ), [@d] * [@c] ), SUMX ( t, [@d] * [@c] ) ) )
		formatString: 0.0%
		displayFolder: Stock
		lineageTag: abc2464a-0888-bf3b-e720-1b45947a534b

	measure 'Rotura %' =
			VAR m = [Mes de la foto de stock]
			RETURN IF ( m < 1, BLANK (), DIVIDE ( CALCULATE ( SUM ( F_Stock[PosicionesAgotadas] ), D_Mes[MesNum] = m ), CALCULATE ( SUM ( F_Stock[Posiciones] ), D_Mes[MesNum] = m ) ) )
		formatString: 0.0%
		displayFolder: Stock
		lineageTag: ec95f3da-0f6b-e68f-454a-80dcc7cd166a

	measure 'Rotura % mes ant' =
			VAR m = [Mes de la foto de stock] - 1
			RETURN IF ( m < 1, BLANK (), DIVIDE ( CALCULATE ( SUM ( F_Stock[PosicionesAgotadas] ), D_Mes[MesNum] = m ), CALCULATE ( SUM ( F_Stock[Posiciones] ), D_Mes[MesNum] = m ) ) )
		formatString: 0.0%
		displayFolder: Stock
		lineageTag: 41f8f474-6f4a-0319-48b3-298260f631a6

	measure 'Cobertura celda' =
			VAR d = [Cobertura art-mes]
			RETURN IF ( ISBLANK ( d ), BLANK (), IF ( d <= 30, "▼ ", "" ) & FORMAT ( d, "0" ) )
		displayFolder: Stock
		lineageTag: fe16e0ec-ab5f-a8af-7f52-e1dcbe8fe955

	measure 'Cobertura color fondo' =
			VAR d = [Cobertura art-mes]
			RETURN IF ( ISBLANK ( d ), BLANK (), IF ( d <= 30, "#121219", IF ( d < 60, "#26262F", IF ( d < 90, "#3F3F4B", "#FF9F43" ) ) ) )
		displayFolder: Stock
		lineageTag: 13dfaa33-19c6-45e4-18d8-ec32c0be626a

	measure 'Cobertura color texto' =
			VAR d = [Cobertura art-mes]
			RETURN IF ( ISBLANK ( d ), BLANK (), IF ( d <= 30, "#FF8A3D", IF ( d >= 90, "#07070A", "#F2F0EA" ) ) )
		displayFolder: Stock
		lineageTag: 64b2633a-a328-c479-db02-f633e7ad2ccb

	measure 'Cobertura art-mes' = CALCULATE ( MAX ( F_Cobertura[Dias] ) )
		formatString: 0
		displayFolder: Stock
		lineageTag: 4594cdc8-da25-0610-0c68-05200892053a

	measure 'Ventas Δ texto' =
			VAR v = [Var Ventas %]
			RETURN IF ( ISBLANK ( v ), "—", IF ( v >= 0, "▲ ", "▼ " ) & SUBSTITUTE ( FORMAT ( v * 100, "+0.0;-0.0" ), "-", "−" ) & " % vs ejercicio anterior" )
		displayFolder: Textos
		lineageTag: a326b440-6bbd-c101-29a0-444552745432

	measure 'Ticket Δ texto' =
			VAR v = [Var Ticket %]
			RETURN IF ( ISBLANK ( v ), "—", IF ( v >= 0, "▲ ", "▼ " ) & SUBSTITUTE ( FORMAT ( v * 100, "+0.0;-0.0" ), "-", "−" ) & " %" )
		displayFolder: Textos
		lineageTag: 0b065f2a-50b2-76fa-55b5-8816205174ad

	measure 'Margen Δ texto' =
			VAR d = ( [Margen %] - [Margen % Ant] ) * 100
			RETURN IF ( ISBLANK ( [Margen %] ) || ISBLANK ( [Margen % Ant] ), "—", IF ( ABS ( d ) < 0.05, "= sin cambio", IF ( d >= 0, "▲ ", "▼ " ) & SUBSTITUTE ( FORMAT ( d, "+0.0;-0.0" ), "-", "−" ) & " pt" ) )
		displayFolder: Textos
		lineageTag: 9d486081-331c-627c-0f2b-7df7d430ef5a

	measure 'Conversión Δ texto' =
			VAR d = ( [Conversión tienda] - [Conversión tienda Ant] ) * 100
			RETURN IF ( ISBLANK ( [Conversión tienda] ) || ISBLANK ( [Conversión tienda Ant] ), "—", IF ( ABS ( d ) < 0.05, "= sin cambio", IF ( d >= 0, "▲ ", "▼ " ) & SUBSTITUTE ( FORMAT ( d, "+0.0;-0.0" ), "-", "−" ) & " pt" ) )
		displayFolder: Textos
		lineageTag: 65ca3195-cd6a-5782-caa1-7065bf92249f

	measure 'Cobertura Δ texto' =
			VAR d = ROUND ( [Cobertura días] - [Cobertura días mes ant], 0 )
			RETURN IF ( ISBLANK ( [Cobertura días] ) || ISBLANK ( [Cobertura días mes ant] ), "—", IF ( d <= 0, "▲ ", "▼ " ) & ABS ( d ) & " días " & IF ( d <= 0, "menos", "más" ) & " que el mes anterior" )
		displayFolder: Textos
		lineageTag: db519500-e9df-baed-ea97-255036a2329c

	measure 'Rotura Δ texto' =
			VAR d = ( [Rotura %] - [Rotura % mes ant] ) * 100
			RETURN IF ( ISBLANK ( [Rotura %] ) || ISBLANK ( [Rotura % mes ant] ), "—", IF ( ABS ( d ) < 0.05, "= sin cambio", IF ( d <= 0, "▲ ", "▼ " ) & SUBSTITUTE ( FORMAT ( d, "+0.0;-0.0" ), "-", "−" ) & " pt" ) )
		displayFolder: Textos
		lineageTag: 31d6d6be-d620-d52f-9eb2-7ab465029719

	measure 'Stock lento Δ texto' =
			VAR d = ( [Stock lento %] - [Stock lento % mes ant] ) * 100
			RETURN IF ( ISBLANK ( [Stock lento %] ) || ISBLANK ( [Stock lento % mes ant] ), "—", IF ( ABS ( d ) < 0.05, "= sin cambio", IF ( d <= 0, "▲ ", "▼ " ) & SUBSTITUTE ( FORMAT ( d, "+0.0;-0.0" ), "-", "−" ) & " pt" ) )
		displayFolder: Textos
		lineageTag: 3f12bd56-f462-1e35-76b0-79af6056bc44

	measure 'Ventas Δ color' =
			VAR t = [Ventas Δ texto]
			RETURN IF ( LEFT ( t, 1 ) = "▲", "#7FD8A0", IF ( LEFT ( t, 1 ) = "▼", "#FF8A3D", "#9A9AA6" ) )
		displayFolder: Textos
		lineageTag: e77e32ed-721f-d7e6-8601-945e646395bc

	measure 'Ticket Δ color' =
			VAR t = [Ticket Δ texto]
			RETURN IF ( LEFT ( t, 1 ) = "▲", "#7FD8A0", IF ( LEFT ( t, 1 ) = "▼", "#FF8A3D", "#9A9AA6" ) )
		displayFolder: Textos
		lineageTag: cce9677b-d6b2-60e0-a9fe-1eb12c8756ad

	measure 'Margen Δ color' =
			VAR t = [Margen Δ texto]
			RETURN IF ( LEFT ( t, 1 ) = "▲", "#7FD8A0", IF ( LEFT ( t, 1 ) = "▼", "#FF8A3D", "#9A9AA6" ) )
		displayFolder: Textos
		lineageTag: 8e698d5e-e787-3dcb-7fe0-56f1ffe8014f

	measure 'Conversión Δ color' =
			VAR t = [Conversión Δ texto]
			RETURN IF ( LEFT ( t, 1 ) = "▲", "#7FD8A0", IF ( LEFT ( t, 1 ) = "▼", "#FF8A3D", "#9A9AA6" ) )
		displayFolder: Textos
		lineageTag: 002c9d2c-0129-6827-b245-7eea7546c6c8

	measure 'Cobertura Δ color' =
			VAR t = [Cobertura Δ texto]
			RETURN IF ( LEFT ( t, 1 ) = "▲", "#7FD8A0", IF ( LEFT ( t, 1 ) = "▼", "#FF8A3D", "#9A9AA6" ) )
		displayFolder: Textos
		lineageTag: e52fcd71-4479-11d9-c547-b3f2de8ebcb6

	measure 'Rotura Δ color' =
			VAR t = [Rotura Δ texto]
			RETURN IF ( LEFT ( t, 1 ) = "▲", "#7FD8A0", IF ( LEFT ( t, 1 ) = "▼", "#FF8A3D", "#9A9AA6" ) )
		displayFolder: Textos
		lineageTag: d47a7c31-93af-7eb8-07ea-335e0ec105ea

	measure 'Stock lento Δ color' =
			VAR t = [Stock lento Δ texto]
			RETURN IF ( LEFT ( t, 1 ) = "▲", "#7FD8A0", IF ( LEFT ( t, 1 ) = "▼", "#FF8A3D", "#9A9AA6" ) )
		displayFolder: Textos
		lineageTag: 7b71b130-0c2f-0aba-22c0-79a3c093a046

	measure 'Color tile treemap' =
			VAR r = RANKX ( ALLSELECTED ( D_Articulo[Articulo] ), [Ventas], , DESC, Dense )
			RETURN IF ( r = 1, "#FF9F43", IF ( r <= 4, "#5E5E6A", "#34343F" ) )
		displayFolder: Producto
		lineageTag: c49c66c7-b66b-b0f7-c513-b98d1cc77a27

	measure 'Color mapa ventas' =
			VAR r = RANKX ( ALL ( D_Territorio[Comunidad] ), [Ventas], , DESC, Dense )
			RETURN IF ( ISBLANK ( [Ventas] ), BLANK (), IF ( r = 1, "#FF9F43", IF ( r <= 5, "#C9C9D1", IF ( r <= 12, "#8D8D99", "#5E5E6A" ) ) ) )
		displayFolder: Mapas
		lineageTag: 4f524969-c33d-8fb1-c9f5-65e6c1109ed6

	measure 'Color mapa margen' =
			VAR m = [Margen %]
			VAR med = CALCULATE ( [Margen %], REMOVEFILTERS ( D_Territorio ) )
			RETURN IF ( ISBLANK ( m ), BLANK (), IF ( m < med - 0.006, "#FF8A3D", IF ( m >= med + 0.004, "#C9C9D1", "#8D8D99" ) ) )
		displayFolder: Mapas
		lineageTag: 42d95b69-82ea-a15e-1807-c184ee32342a

	measure 'Color mapa online' =
			VAR c = [Cuota online]
			VAR med = CALCULATE ( [Cuota online], REMOVEFILTERS ( D_Territorio ) )
			RETURN IF ( ISBLANK ( c ), BLANK (), IF ( c > med + 0.01, "#FF9F43", "#8D8D99" ) )
		displayFolder: Mapas
		lineageTag: 4d7d45ba-d237-c037-ca3b-a3fad8800a1f

	measure 'Nivel mapa ventas' =
			VAR mx = MAXX ( ALL ( D_Territorio[Comunidad] ), [Ventas] )
			VAR esDest = RANKX ( ALL ( D_Territorio[Comunidad] ), [Ventas], , DESC, Dense ) = 1
			RETURN IF ( ISBLANK ( [Ventas] ), BLANK (), IF ( esDest, 100, 45 * DIVIDE ( [Ventas], mx ) ) )
		displayFolder: Mapas
		lineageTag: 10dced8f-35e6-77fa-4263-8f2483d2632d

	measure 'Nivel mapa margen' =
			VAR mx = MAXX ( ALL ( D_Territorio[Comunidad] ), [Ventas] )
			VAR esDest = [Margen %] < CALCULATE ( [Margen %], REMOVEFILTERS ( D_Territorio ) ) - 0.006
			RETURN IF ( ISBLANK ( [Ventas] ), BLANK (), IF ( esDest, 100, 45 * DIVIDE ( [Ventas], mx ) ) )
		displayFolder: Mapas
		lineageTag: 500d1768-c701-3322-e857-5c10cf3bcdfb

	measure 'Nivel mapa online' =
			VAR mx = MAXX ( ALL ( D_Territorio[Comunidad] ), [Ventas online mapa] )
			VAR esDest = [Cuota online] > CALCULATE ( [Cuota online], REMOVEFILTERS ( D_Territorio ) ) + 0.01
			RETURN IF ( ISBLANK ( [Ventas online mapa] ), BLANK (), IF ( esDest, 100, 45 * DIVIDE ( [Ventas online mapa], mx ) ) )
		displayFolder: Mapas
		lineageTag: 3e46c8f6-55c0-934b-dcef-18507c9bdfc7

	measure 'Mapa ventas dest' =
			VAR r = RANKX ( ALL ( D_Territorio[Comunidad] ), [Ventas], , DESC, Dense )
			RETURN IF ( ISBLANK ( [Ventas] ), BLANK (), IF ( r = 1, [Ventas], BLANK () ) )
		displayFolder: Mapas
		lineageTag: 8c6bdcd8-78c7-8100-190d-79c8c34ce290

	measure 'Mapa ventas resto' =
			VAR r = RANKX ( ALL ( D_Territorio[Comunidad] ), [Ventas], , DESC, Dense )
			RETURN IF ( ISBLANK ( [Ventas] ), BLANK (), IF ( r = 1, BLANK (), [Ventas] ) )

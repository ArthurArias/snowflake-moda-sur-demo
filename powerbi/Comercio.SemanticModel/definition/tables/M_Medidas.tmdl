	measure 'Color spark' =
			VAR n = MAX ( D_MesSpark[MesNum] )
			RETURN IF ( COUNTROWS ( VALUES ( D_Mes[MesNum] ) ) < 12, IF ( n IN VALUES ( D_Mes[MesNum] ), "#FF9F43", "#5E5E6A" ), IF ( n = 12, "#FF9F43", "#5E5E6A" ) )
		displayFolder: Minigráficos
		lineageTag: 1b1c702c-4444-fe47-b964-6b7e4068cc6f

	measure 'Spark ticket' =
			VAR v = CALCULATE ( [Ticket medio], REMOVEFILTERS ( D_Mes ), TREATAS ( VALUES ( D_MesSpark[MesNum] ), D_Mes[MesNum] ) )
			VAR t = ADDCOLUMNS ( ALL ( D_MesSpark[MesNum] ), "@v", CALCULATE ( [Ticket medio], REMOVEFILTERS ( D_Mes ), TREATAS ( { [MesNum] }, D_Mes[MesNum] ) ) )
			VAR mx = MAXX ( t, [@v] )
			VAR mn = MINX ( t, [@v] )
			VAR lo = mn - ( mx - mn ) * 0.6
			RETURN IF ( ISBLANK ( v ), BLANK (), MAX ( v - lo, ( mx - lo ) * 0.07 ) )
		formatString: #,0.0
		displayFolder: Minigráficos
		lineageTag: b307804b-5021-70ee-5c9d-08ae1240b384

	measure 'Spark margen' =
			VAR v = CALCULATE ( [Margen %], REMOVEFILTERS ( D_Mes ), TREATAS ( VALUES ( D_MesSpark[MesNum] ), D_Mes[MesNum] ) )
			VAR t = ADDCOLUMNS ( ALL ( D_MesSpark[MesNum] ), "@v", CALCULATE ( [Margen %], REMOVEFILTERS ( D_Mes ), TREATAS ( { [MesNum] }, D_Mes[MesNum] ) ) )
			VAR mx = MAXX ( t, [@v] )
			VAR mn = MINX ( t, [@v] )
			VAR lo = mn - ( mx - mn ) * 0.6
			RETURN IF ( ISBLANK ( v ), BLANK (), MAX ( v - lo, ( mx - lo ) * 0.07 ) )
		formatString: 0.0%
		displayFolder: Minigráficos
		lineageTag: f8bca004-fa81-5314-3a5a-0aded6c12573

	measure 'Spark conversión' =

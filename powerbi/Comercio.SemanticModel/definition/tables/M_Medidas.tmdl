		displayFolder: Ventas
		lineageTag: 996a9f9d-e5ca-9877-e13c-b5ea14ace4b7

	measure 'Margen %' = DIVIDE ( [Ventas] - SUM ( F_Ventas[Coste] ), [Ventas] )
		formatString: 0.0%
		displayFolder: Ventas
		lineageTag: 8aa13497-eb11-1d2d-c7c0-97aa08ebcf39

	measure 'Margen % Ant' = DIVIDE ( [Ventas Ant] - SUM ( F_Ventas[CosteAnt] ), [Ventas Ant] )
		formatString: 0.0%
		displayFolder: Ventas
		lineageTag: 1cdb25a5-63a8-de92-d635-c81418df2b20

	measure 'Conversión tienda' = DIVIDE ( CALCULATE ( SUM ( F_Ventas[Tickets] ), KEEPFILTERS ( D_Linea[Linea] = "Tienda física" ) ), SUM ( F_Ventas[Visitantes] ) )
		formatString: 0.0%
		displayFolder: Ventas
		lineageTag: 8445d092-6fc3-a107-7983-a16b230451c2

	measure 'Conversión tienda Ant' = DIVIDE ( CALCULATE ( SUM ( F_Ventas[TicketsAnt] ), KEEPFILTERS ( D_Linea[Linea] = "Tienda física" ) ), SUM ( F_Ventas[VisitantesAnt] ) )
		formatString: 0.0%
		displayFolder: Ventas

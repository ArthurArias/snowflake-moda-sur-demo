	measure 'Sell-through celda' =
			VAR s = [Sell-through]
			RETURN IF ( ISBLANK ( s ), BLANK (), IF ( s < 0.55, "▼ ", "" ) & FORMAT ( s, "0%" ) )
		displayFolder: Producto
		lineageTag: 4628595e-09f2-58bb-978c-dc5f0ee8f856

	measure 'Color sell-through' = IF ( [Sell-through] < 0.55, "#FF8A3D", "#F2F0EA" )
		displayFolder: Producto
		lineageTag: fcca600c-00af-2a78-3432-4cce24900018

	measure 'Color var' = IF ( [Var Ventas %] >= 0, "#7FD8A0", "#FF8A3D" )
		displayFolder: Producto
		lineageTag: 31801398-f992-bca3-f4a4-44fc9c914722

	measure 'PC Margen' =
			VAR dm = [Margen %] - [Margen % Ant]
			VAR g = [Var Ventas %]
			VAR perd = -dm * [Ventas]
			RETURN IF ( dm < -0.002,
			    IF ( g >= 0,
			        "▼ Vendes un " & FORMAT ( g * 100, "0.0" ) & " % más, pero el margen baja " & FORMAT ( -dm * 100, "0.0" ) & " pt. Esa bajada cuesta " & FORMAT ( perd, "#,0" ) & " k€ y no se ve en la cifra de ventas.",
			        "▼ Las ventas bajan un " & FORMAT ( -g * 100, "0.0" ) & " % y el margen cae " & FORMAT ( -dm * 100, "0.0" ) & " pt: pierdes por volumen y por margen a la vez." ),
			    "" )
		displayFolder: Puntos ciegos
		lineageTag: 88e507fc-0d1f-699a-8a8a-8318956cea9d

	measure 'PC Meses bajo objetivo' =
			VAR t = ADDCOLUMNS ( FILTER ( VALUES ( D_Mes[MesNum] ), [Ventas] < [Objetivo] ), "@n", LOOKUPVALUE ( D_Mes[Mes], D_Mes[MesNum], D_Mes[MesNum] ), "@o", D_Mes[MesNum] )
			VAR n = COUNTROWS ( t )
			VAR k = COUNTROWS ( VALUES ( D_Mes[MesNum] ) )
			VAR lst = CONCATENATEX ( t, [@n], ", ", [@o], ASC )
			VAR ult = MAXX ( TOPN ( 1, t, [@o], DESC ), [@n] )
			RETURN IF ( n > 0, "▼ No llegas al objetivo en " & n & " de " & k & " meses (" & IF ( n > 1, SUBSTITUTE ( lst, ", " & ult, " y " & ult ), lst ) & "). El total puede salir bien y esconder esos meses.", "" )
		displayFolder: Puntos ciegos
		lineageTag: a37d6bd7-b41e-0613-c8de-97f6a8638456

	measure 'PC Concentración' =
			VAR t = ADDCOLUMNS ( ALL ( D_Territorio[Comunidad] ), "@n", D_Territorio[Comunidad], "@o", VAR c = D_Territorio[Comunidad] RETURN CALCULATE ( [Ventas], REMOVEFILTERS ( D_Territorio ), D_Territorio[Comunidad] = c ) )
			VAR top3 = TOPN ( 3, t, [@o], DESC )
			VAR cuota = DIVIDE ( SUMX ( top3, [@o] ), SUMX ( t, [@o] ) )
			VAR lst = CONCATENATEX ( top3, [@n], ", ", [@o], DESC )
			VAR ult = MAXX ( TOPN ( 1, top3, [@o], ASC ), [@n] )
			RETURN IF ( cuota >= 0.4, "▼ " & IF ( 3 > 1, SUBSTITUTE ( lst, ", " & ult, " y " & ult ), lst ) & " concentran el " & FORMAT ( cuota * 100, "0.0" ) & " % de las ventas. Una incidencia en una de ellas mueve todo el resultado.", "" )
		displayFolder: Puntos ciegos
		lineageTag: 355d60c0-80f9-de36-559e-43fc4c373e9c

	measure 'PC Comunidad rezagada' =
			VAR t = ADDCOLUMNS ( ALL ( D_Territorio[Comunidad] ),
			    "@n", D_Territorio[Comunidad],
			    "@v", VAR c = D_Territorio[Comunidad] RETURN CALCULATE ( [Ventas], REMOVEFILTERS ( D_Territorio ), D_Territorio[Comunidad] = c ),
			    "@p", VAR c = D_Territorio[Comunidad] RETURN CALCULATE ( [Ventas Ant], REMOVEFILTERS ( D_Territorio ), D_Territorio[Comunidad] = c ) )
			VAR ga = DIVIDE ( SUMX ( t, [@v] ), SUMX ( t, [@p] ) )
			VAR t2 = ADDCOLUMNS ( FILTER ( t, [@p] > 0 ), "@gap", [@p] * ga - [@v], "@g", DIVIDE ( [@v], [@p] ) - 1, "@r", RANKX ( t, [@v], , DESC, Dense ) )
			VAR peor = TOPN ( 1, t2, [@gap], DESC )
			VAR gap = MAXX ( peor, [@gap] )
			RETURN IF ( gap >= 3, "▼ " & MAXX ( peor, [@n] ) & ", " & MAXX ( peor, [@r] ) & ".ª comunidad por ventas, crece un " & FORMAT ( MAXX ( peor, [@g] ) * 100, "0.0" ) & " % frente al " & FORMAT ( ( ga - 1 ) * 100, "0.0" ) & " % del total. Si creciera como la media, serían " & FORMAT ( gap, "#,0" ) & " k€ más.", "" )
		displayFolder: Puntos ciegos
		lineageTag: fa316fdd-b29f-63c0-6613-4ba8722009d2

	measure 'PC Concentración artículos' =
			VAR t = ADDCOLUMNS ( VALUES ( D_Articulo[Articulo] ), "@n", D_Articulo[Articulo], "@o", [Ventas] )
			VAR n = COUNTROWS ( t )
			VAR top3 = TOPN ( 3, t, [@o], DESC )
			VAR cuota = DIVIDE ( SUMX ( top3, [@o] ), SUMX ( t, [@o] ) )
			VAR lst = CONCATENATEX ( top3, [@n], ", ", [@o], DESC )
			VAR ult = MAXX ( TOPN ( 1, top3, [@o], ASC ), [@n] )
			RETURN IF ( n >= 4 && cuota >= 0.4, "▼ " & IF ( 3 > 1, SUBSTITUTE ( lst, ", " & ult, " y " & ult ), lst ) & " suman el " & FORMAT ( cuota * 100, "0.0" ) & " % de las ventas: si falla uno, se nota en todo.", "" )
		displayFolder: Puntos ciegos
		lineageTag: 574782b3-572c-d1a0-a437-545383def547

	measure 'PC Margen artículo' =
			VAR med = [Margen %]
			VAR t = ADDCOLUMNS ( VALUES ( D_Articulo[Articulo] ), "@n", D_Articulo[Articulo], "@v", [Ventas], "@m", [Margen %] )
			VAR tv = SUMX ( t, [@v] )
			VAR c = FILTER ( t, DIVIDE ( [@v], tv ) >= 0.08 && ( med - [@m] ) >= 0.05 )
			VAR p = TOPN ( 1, c, ( med - [@m] ) * [@v], DESC )
			RETURN IF ( COUNTROWS ( p ) > 0, "▼ " & MAXX ( p, [@n] ) & ": el " & FORMAT ( DIVIDE ( MAXX ( p, [@v] ), tv ) * 100, "0.0" ) & " % de las ventas con un margen del " & FORMAT ( MAXX ( p, [@m] ) * 100, "0" ) & " %, " & FORMAT ( ( med - MAXX ( p, [@m] ) ) * 100, "0.0" ) & " pt por debajo de la media. Vende mucho y deja poco.", "" )
		displayFolder: Puntos ciegos
		lineageTag: 21c0b665-5047-bf34-93c0-550f4869df18

	measure 'PC Artículo en caída' =
			VAR t = ADDCOLUMNS ( VALUES ( D_Articulo[Articulo] ), "@n", D_Articulo[Articulo], "@v", [Ventas], "@p", [Ventas Ant] )
			VAR tv = SUMX ( t, [@v] )
			VAR c = FILTER ( t, DIVIDE ( [@v], tv ) >= 0.08 && [@p] > 0 && [@v] < [@p] * 0.98 )
			VAR pk = TOPN ( 1, c, [@p] - [@v], DESC )
			RETURN IF ( COUNTROWS ( pk ) > 0, "▼ En " & MAXX ( pk, [@n] ) & ", de los grandes, las ventas caen un " & FORMAT ( ( 1 - DIVIDE ( MAXX ( pk, [@v] ), MAXX ( pk, [@p] ) ) ) * 100, "0.0" ) & " % frente al ejercicio anterior" & IF ( [Ventas] > [Ventas Ant], " mientras el total crece", "" ) & ".", "" )
		displayFolder: Puntos ciegos
		lineageTag: 9a3b95bf-39da-b415-f599-adebc210799b

	measure 'PC Sell-through' =
			VAR t = ADDCOLUMNS ( VALUES ( D_Articulo[Articulo] ), "@n", D_Articulo[Articulo], "@v", [Ventas], "@st", [Sell-through] )
			VAR r = ADDCOLUMNS ( t, "@r", RANKX ( t, [@v], , DESC, Dense ) )
			VAR c = FILTER ( r, [@r] <= 5 && [@st] < 0.6 )
			VAR pk = TOPN ( 1, c, ( 1 / [@st] - 1 ) * [@v], DESC )
			RETURN IF ( COUNTROWS ( pk ) > 0, "▼ En " & MAXX ( pk, [@n] ) & " (nº " & MAXX ( pk, [@r] ) & " en ventas) solo se vende el " & FORMAT ( MAXX ( pk, [@st] ) * 100, "0" ) & " % de lo que recibes: capital parado en almacén.", "" )
		displayFolder: Puntos ciegos
		lineageTag: 20529aae-cdbd-57fb-0d8a-48005e764f1d

	measure 'PC Stock parado' =
			VAR m = [Mes de la foto de stock]
			VAR t = ADDCOLUMNS ( VALUES ( D_Articulo[ArticuloId] ), "@id", D_Articulo[ArticuloId], "@n", LOOKUPVALUE ( D_Articulo[Articulo], D_Articulo[ArticuloId], D_Articulo[ArticuloId] ), "@d", CALCULATE ( MAX ( F_Cobertura[Dias] ), D_Mes[MesNum] = m ), "@c", CALCULATE ( [Coste art-mes], D_Mes[MesNum] = m ) )
			VAR l = FILTER ( t, [@d] >= 90 )
			VAR n = COUNTROWS ( l )
			VAR val = SUMX ( l, [@d] * [@c] / 30 )
			VAR lst = CONCATENATEX ( l, [@n], ", ", [@id], ASC )
			VAR ult = MAXX ( TOPN ( 1, l, [@id], DESC ), [@n] )
			RETURN IF ( n > 0, "▼ " & n & IF ( n = 1, " artículo supera", " artículos superan" ) & " los 90 días de cobertura (" & IF ( n > 1, SUBSTITUTE ( lst, ", " & ult, " y " & ult ), lst ) & "): inmovilizan " & FORMAT ( val, "#,0" ) & " k€.", "" )
		displayFolder: Puntos ciegos
		lineageTag: ba28aae9-70c1-0784-bf20-fc0d3d5760d7

	measure 'PC Riesgo rotura' =
			VAR m = [Mes de la foto de stock]
			VAR t = ADDCOLUMNS ( VALUES ( D_Articulo[Articulo] ), "@n", D_Articulo[Articulo], "@d", CALCULATE ( MAX ( F_Cobertura[Dias] ), D_Mes[MesNum] = m ), "@v", CALCULATE ( SUM ( F_Ventas[Ventas] ), REMOVEFILTERS ( D_Mes ), D_Mes[MesNum] = m, REMOVEFILTERS ( D_Linea ), REMOVEFILTERS ( D_Territorio ) ) )
			VAR top5 = TOPN ( 5, t, [@v], DESC )
			VAR r = FILTER ( top5, [@d] <= 30 )
			VAR n = COUNTROWS ( r )
			VAR imp = SUMX ( r, [@v] ) * 0.5
			VAR lst = CONCATENATEX ( r, [@n], ", ", [@v], DESC )
			VAR ult = MAXX ( TOPN ( 1, r, [@v], ASC ), [@n] )
			RETURN IF ( n > 0, "▼ Entre los 5 artículos más vendidos del mes, con 30 días de cobertura o menos: " & IF ( n > 1, SUBSTITUTE ( lst, ", " & ult, " y " & ult ), lst ) & ". Dos semanas sin stock cuestan ~" & FORMAT ( imp, "#,0" ) & " k€.", "" )
		displayFolder: Puntos ciegos
		lineageTag: 08eb048a-08c8-2693-ddf2-69d32e7c4e2b

	measure 'PC Canal agotados' =
			VAR t = ADDCOLUMNS ( VALUES ( D_Linea[Linea] ), "@n", D_Linea[Linea], "@id", CALCULATE ( MAX ( D_Linea[LineaId] ) ), "@p", [Rotura %] )
			VAR media = [Rotura %]
			VAR w = TOPN ( 1, t, ROUND ( [@p], 4 ), DESC, [@id], ASC )
			RETURN IF ( COUNTROWS ( t ) > 1 && MAXX ( w, [@p] ) - media >= 0.008, "▼ " & MAXX ( w, [@n] ) & " tiene el " & FORMAT ( MAXX ( w, [@p] ) * 100, "0.0" ) & " % de sus posiciones agotadas, frente al " & FORMAT ( media * 100, "0.0" ) & " % del total: es donde más ventas se escapan.", "" )
		displayFolder: Puntos ciegos
		lineageTag: 06c82e08-60b2-88a7-5994-0d5cd9f31759

	measure 'PC Mezcla canales' =
			VAR t = ADDCOLUMNS ( ALL ( D_Linea[Linea] ), "@n", D_Linea[Linea],
			    "@v", VAR l = D_Linea[Linea] RETURN CALCULATE ( [Ventas], REMOVEFILTERS ( D_Linea ), D_Linea[Linea] = l ),
			    "@p", VAR l = D_Linea[Linea] RETURN CALCULATE ( [Ventas Ant], REMOVEFILTERS ( D_Linea ), D_Linea[Linea] = l ),
			    "@m", VAR l = D_Linea[Linea] RETURN CALCULATE ( [Margen %], REMOVEFILTERS ( D_Linea ), D_Linea[Linea] = l ) )
			VAR T0 = SUMX ( t, [@v] )
			VAR TP = SUMX ( t, [@p] )
			VAR eff = SUMX ( t, ( DIVIDE ( [@v], T0 ) - DIVIDE ( [@p], TP ) ) * [@m] * 100 )
			VAR vo = MAXX ( FILTER ( t, [@n] = "Online" ), [@v] )
			VAR vt = MAXX ( FILTER ( t, [@n] = "Tienda física" ), [@v] )
			VAR po = MAXX ( FILTER ( t, [@n] = "Online" ), [@p] )
			VAR mo = MAXX ( FILTER ( t, [@n] = "Online" ), [@m] )
			VAR mt = MAXX ( FILTER ( t, [@n] = "Tienda física" ), [@m] )
			RETURN IF ( T0 > 0 && TP > 0 && eff < -0.1 && vo > 0 && vt > 0, "▼ Online pasa del " & FORMAT ( DIVIDE ( po, TP ) * 100, "0.0" ) & " % al " & FORMAT ( DIVIDE ( vo, T0 ) * 100, "0.0" ) & " % de las ventas y su margen es el " & FORMAT ( mo * 100, "0.0" ) & " %, frente al " & FORMAT ( mt * 100, "0.0" ) & " % de tienda. Solo por la mezcla, el margen total se mueve " & SUBSTITUTE ( FORMAT ( eff, "+0.00;-0.00" ), "-", "−" ) & " pt.", "" )
		displayFolder: Puntos ciegos
		lineageTag: dea0a392-8d90-09f4-3576-92901377f4b0

	measure 'PC Concentración canal' =
			VAR t = ADDCOLUMNS ( ALL ( D_Linea[Linea] ), "@n", D_Linea[Linea],
			    "@v", VAR l = D_Linea[Linea] RETURN CALCULATE ( [Ventas], REMOVEFILTERS ( D_Linea ), D_Linea[Linea] = l ),
			    "@p", VAR l = D_Linea[Linea] RETURN CALCULATE ( [Ventas Ant], REMOVEFILTERS ( D_Linea ), D_Linea[Linea] = l ),
			    "@m", VAR l = D_Linea[Linea] RETURN CALCULATE ( [Margen %], REMOVEFILTERS ( D_Linea ), D_Linea[Linea] = l ) )
			VAR T0 = SUMX ( t, [@v] )
			VAR mx = TOPN ( 1, t, [@v], DESC )
			VAR sh = DIVIDE ( MAXX ( mx, [@v] ), T0 )
			RETURN IF ( T0 > 0 && sh >= 0.5, "▼ " & MAXX ( mx, [@n] ) & " concentra el " & FORMAT ( sh * 100, "0.0" ) & " % de las ventas: un problema en ese canal es un problema de toda la empresa.", "" )
		displayFolder: Puntos ciegos
		lineageTag: 6bf14de6-7089-d9d4-2635-f1c61bf7a876

	measure 'PC Embudo' =
			VAR r = MIN ( MIN ( 0.578, 0.173 ), 0.27 )
			VAR g = [Ventas online] * 0.01 / r
			RETURN IF ( [Compras online] > 0, "▼ Se pierde el " & FORMAT ( ( 1 - r ) * 100, "0" ) & " % de los clientes entre la ficha de producto y el carrito. Cada punto de conversión que recuperes ahí son ~" & FORMAT ( g, "#,0" ) & " k€ de ventas online.", "" )
		displayFolder: Puntos ciegos
		lineageTag: ae934cde-d4d8-d5cf-cca7-f88ee4dc93b4

	measure Meta = 1
		formatString: 0%
		displayFolder: Ventas
		lineageTag: 77a4ec98-af1f-988d-5d74-2bde68b7f9c4

	column Dummy
		dataType: string
		isHidden
		lineageTag: eee0e46b-ccad-f742-9212-4b716bd050ae
		summarizeBy: none
		sourceColumn: Dummy

	partition M_Medidas = m
		mode: import
		source =
				let
				    Origen = #table(type table [Dummy = text], {})
				in
				    Origen

	annotation PBI_ResultType = Table


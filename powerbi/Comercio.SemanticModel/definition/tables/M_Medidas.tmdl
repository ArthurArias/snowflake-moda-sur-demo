			VAR t = ADDCOLUMNS ( ALL ( D_MesSpark[MesNum] ), "@v", CALCULATE ( [Conversión tienda], REMOVEFILTERS ( D_Mes ), TREATAS ( { [MesNum] }, D_Mes[MesNum] ) ) )
			VAR mx = MAXX ( t, [@v] )
			VAR mn = MINX ( t, [@v] )

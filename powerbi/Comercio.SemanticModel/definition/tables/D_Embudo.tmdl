		annotation SummarizationSetBy = Automatic

	column Paso
		dataType: string
		lineageTag: b77a53f0-97a1-e622-6d33-8e02fde60e6e
		summarizeBy: none
		sourceColumn: Paso
		sortByColumn: Orden

		annotation SummarizationSetBy = Automatic

	partition D_Embudo = m
		mode: import
		source =
				let
				    Origen = Snowflake.Databases("TU_CUENTA.snowflakecomputing.com", "DEMO_VIDEO_WH", [Role = "ACCOUNTADMIN"]),
				    BD = Origen{[Name = "DEMO_VIDEO", Kind = "Database"]}[Data],
				    Esquema = BD{[Name = "MODELO", Kind = "Schema"]}[Data],
				    Encabezados = Esquema{[Name = "D_EMBUDO", Kind = "View"]}[Data],
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"Orden", Int64.Type}, {"Paso", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table


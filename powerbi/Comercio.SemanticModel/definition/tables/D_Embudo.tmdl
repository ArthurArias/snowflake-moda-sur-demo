table D_Embudo
	lineageTag: af2b7499-1bc6-a7b1-b15d-49c9558d0de7

	column Orden
		dataType: int64
		lineageTag: 8026029a-487c-4b0c-c604-7826167bcc9b
		summarizeBy: none

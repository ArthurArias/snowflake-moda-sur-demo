	partition F_Stock = m
		mode: import
		source =
				let
				    Origen = Snowflake.Databases("TU_CUENTA.snowflakecomputing.com", "DEMO_VIDEO_WH", [Role = "ACCOUNTADMIN"]),
				    BD = Origen{[Name = "DEMO_VIDEO", Kind = "Database"]}[Data],
				    Esquema = BD{[Name = "MODELO", Kind = "Schema"]}[Data],
				    Encabezados = Esquema{[Name = "F_STOCK", Kind = "View"]}[Data],
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"MesNum", Int64.Type}, {"LineaId", Int64.Type}, {"ArticuloId", Int64.Type}, {"Posiciones", type number}, {"PosicionesBajas", type number}, {"PosicionesAgotadas", type number}}, "en-US")
				in
